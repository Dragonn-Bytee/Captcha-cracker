{
  "manifest_version": 3,
  "name": "AutoLogin with Captcha Pause",
  "version": "1.0",
  "description": "Autofills credentials securely and pauses for manual Captcha solving.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://students.cuchd.in/*",
    "https://api.ocr.space/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoLogin Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://students.cuchd.in/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
