{
  "manifest_version": 3,
  "name": "AutoLogin with Captcha Pause",
  "version": "1.0",
  "description": "Autofills credentials securely and pauses for manual Captcha solving.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.ocr.space/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoLogin Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
